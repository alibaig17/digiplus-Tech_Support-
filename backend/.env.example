# ===== MongoDB Atlas =====
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_support_copilot

# ===== JWT =====
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== OTP =====
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
# When true, OTP codes are printed to the backend console instead of emailed
# (handy for local dev without a Brevo account). Set to false in production.
DEV_MODE_LOG_OTP=true

# ===== Brevo (https://app.brevo.com/settings/keys/api) =====
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=AI Support Copilot

# ===== Gemini (https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ===== ChromaDB =====
CHROMA_PERSIST_DIR=./chroma_data

# ===== Uploads =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ===== CORS =====
FRONTEND_ORIGIN=http://localhost:5173

ENV=development
